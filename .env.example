# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Host port exposed by Docker Compose for PostgreSQL.
# Change this if you already have another local Postgres instance using 5432.
SECOND_BRAIN_DB_PORT=55432

# Connection string used by all apps in this repo.
# This should match the username, password, host, port, and database name used
# by your local Docker Compose setup.
SECOND_BRAIN_DB_DSN=postgresql://second_brain:second_brain@127.0.0.1:55432/second_brain


# -----------------------------------------------------------------------------
# Retrieval / embeddings
# -----------------------------------------------------------------------------

# Embedding vector size stored in PostgreSQL.
# Keep this aligned with the embedder implementation and the database schema.
SECOND_BRAIN_EMBEDDING_DIMENSION=256


# -----------------------------------------------------------------------------
# Memory scopes
# -----------------------------------------------------------------------------

# Default memory scope used when a command does not specify one explicitly.
# Good examples:
# - general
# - project:second-brain
# - project:ai-recruitment
SECOND_BRAIN_DEFAULT_MEMORY_SCOPE=project:second-brain

# Primary way to map memory scopes to local folders.
# Format:
#   scope|path;scope|path
#
# Example:
#   project:second-brain|.;general|~/notes
#
# This lets one stack host multiple isolated memories at once.
SECOND_BRAIN_MEMORY_ROOTS=project:second-brain|.

# Legacy / fallback local file roots.
# Only used if SECOND_BRAIN_MEMORY_ROOTS is empty.
# Format:
#   comma-separated paths
SECOND_BRAIN_FILE_ROOTS=./sample-data


# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------

# Name reported by the stdio MCP server.
# Useful when wiring the server into Claude or Codex configs.
SECOND_BRAIN_MCP_SERVER_NAME=second-brain


# -----------------------------------------------------------------------------
# OneNote / Microsoft Graph delegated auth
# -----------------------------------------------------------------------------

# Microsoft Entra tenant to authenticate against.
# These settings reference an existing app registration. They do not create or
# provision Microsoft Entra configuration for you.
# Use:
# - common      for multi-tenant delegated sign-in
# - a tenant ID if you want to constrain login to one tenant
SECOND_BRAIN_ONENOTE_TENANT_ID=common

# Public client application ID registered in Microsoft Entra for delegated Graph access.
# Required for OneNote sync. You must create or reuse an Entra app registration
# before ingest-onenote will work, then place that app's client ID here.
SECOND_BRAIN_ONENOTE_CLIENT_ID=

# Comma-separated Microsoft Graph delegated scopes requested during login.
# Notes.Read.All is the key OneNote permission for read-only sync with the
# current delegated device-code flow. These scopes must also be configured on
# the Entra app registration.
SECOND_BRAIN_ONENOTE_SCOPES=offline_access,Notes.Read.All,User.Read

# File path used to cache delegated Microsoft Graph tokens for background syncs.
# The file is created automatically on first successful login.
SECOND_BRAIN_ONENOTE_TOKEN_CACHE_PATH=~/.second-brain/onenote-token.json

# Automatically open the Microsoft device login page when interactive sign-in is needed.
# Set this to false for headless environments.
SECOND_BRAIN_ONENOTE_AUTO_OPEN_BROWSER=true

# Timeout in seconds for OneNote auth and API calls.
SECOND_BRAIN_ONENOTE_TIMEOUT_SECONDS=30

# User-Agent string sent to Microsoft Graph.
# Useful for diagnostics and polite API identification.
SECOND_BRAIN_ONENOTE_USER_AGENT=second-brain/0.1.0

# Memory scope assigned to ingested OneNote content.
# For most setups this should be:
# - general
# But it can also be a project scope if you want notebook content to stay local
# to one project memory.
SECOND_BRAIN_ONENOTE_MEMORY_SCOPE=general
